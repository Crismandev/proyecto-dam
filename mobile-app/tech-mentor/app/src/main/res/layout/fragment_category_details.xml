<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fitsSystemWindows="true">

    <!-- HEADER -->
    <include
        android:id="@+id/header"
        layout="@layout/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- INFORMACIÓN DE LA RUTA / CATEGORÍA -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clRouteInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/header">

        <!-- Ícono de la Categoría -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvRouteIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardBackgroundColor="@color/bg_purple"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivRouteIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_code_purple"
                app:tint="@color/purple" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Texto "Escuela" -->
        <TextView
            android:id="@+id/tvStaticEscuela"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:text="Escuela"
            android:textColor="@color/purple"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@id/tvRouteTitle"
            app:layout_constraintStart_toEndOf="@id/cvRouteIcon"
            app:layout_constraintTop_toTopOf="@id/cvRouteIcon"
            app:layout_constraintVertical_chainStyle="packed" />

        <!-- Nombre de la ruta -->
        <TextView
            android:id="@+id/tvRouteTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/plus_jakarta_sans_extrabold"
            android:textColor="@color/black"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="@id/cvRouteIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cvRouteIcon"
            app:layout_constraintTop_toBottomOf="@id/tvStaticEscuela"
            tools:text="Desarrollo Web" />

        <!-- Descripción de la ruta -->
        <TextView
            android:id="@+id/tvRouteDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_gray"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/cvRouteIcon"
            tools:text="Desarrolla aplicaciones web desde cero y haz realidad tu carrera como Web Developer. Sé parte de la industria con los empleos mejor pagados a nivel global." />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- TÍTULO DE LA LISTA DE CURSOS -->
    <TextView
        android:id="@+id/tvCoursesHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/plus_jakarta_sans_bold"
        android:text="Cursos de la ruta"
        android:textColor="@color/black"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/clRouteInfo" />

    <!-- RECYCLER VIEW DE CURSOS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRouteCourses"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingHorizontal="24dp"
        android:paddingBottom="20dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCoursesHeader"
        tools:listitem="@layout/item_course" />

</androidx.constraintlayout.widget.ConstraintLayout>