<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- HEADER (Fijo en la parte superior) -->
    <include
        android:id="@+id/header"
        layout="@layout/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- SCROLLVIEW -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="40dp">

            <!-- BOTÓN ATRÁS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/selector_border_input"
                app:strokeWidth="1dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_left"
                    app:tint="@color/black"
                    tools:src="@drawable/ic_arrow_left" />
            </com.google.android.material.card.MaterialCardView>

            <!-- TÍTULO SUPERIOR -->
            <TextView
                android:id="@+id/tvCrearCuentaHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/action_create_account"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/cvBack"
                app:layout_constraintStart_toEndOf="@id/cvBack"
                app:layout_constraintTop_toTopOf="@id/cvBack" />

            <!-- IMAGEN -->

<!-- Versión anterior conservada como referencia.
            <ImageView
                android:id="@+id/ivRobotRegister"
                android:layout_width="wrap_content"
                android:layout_height="300dp"
                android:layout_marginTop="24dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cvBack"
                tools:src="@tools:sample/avatars" />
-->
            <ImageView
                android:id="@+id/ivRobotRegister"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_bit"
                android:contentDescription="@string/bit_description"
                android:layout_marginTop="24dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cvBack"
                tools:src="@drawable/ic_bit" />

            <!-- TÍTULO PRINCIPAL -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:text="@string/title_register"
                android:textColor="@color/black"
                android:textSize="26sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivRobotRegister" />

            <!-- DESCRIPCIÓN -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:text="@string/desc_register_subtitle"
                android:textColor="@color/text_gray_medium"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTitle" />

            <include
                android:id="@+id/authTabs"
                layout="@layout/layout_auth_tabs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="28dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDescription" />

            <!-- SECCIÓN: SUBIR AVATAR -->

<!-- Versión anterior conservada como referencia.
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvAvatar"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="32dp"
                app:cardCornerRadius="40dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/purple"
                app:strokeWidth="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDescription">

                <ImageView
                    android:id="@+id/ivAvatarPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@color/white"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/purple"
                    android:padding="24dp" />
            </com.google.android.material.card.MaterialCardView>
-->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvAvatar"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="32dp"
                app:cardCornerRadius="40dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/purple"
                app:strokeWidth="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/authTabs">

                <ImageView
                    android:id="@+id/ivAvatarPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@color/white"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/purple"
                    android:padding="24dp" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvSubirFoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:text="@string/action_upload_profile_photo"
                android:textColor="@color/purple"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cvAvatar" />

            <!-- ETIQUETA: Nombres -->
            <TextView
                android:id="@+id/tvLabelNombres"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="32dp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:text="@string/label_first_names"
                android:textColor="@color/black"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSubirFoto" />

            <!-- INPUT: Nombres -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNombres"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/selector_border_input"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_user"
                app:startIconTint="@color/text_gray"
                app:layout_constraintTop_toBottomOf="@id/tvLabelNombres">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombres"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:hint="@string/hint_first_names"
                    android:inputType="textPersonName"
                    android:paddingVertical="16dp"
                    android:paddingStart="4dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/text_gray"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ETIQUETA: Apellidos -->
            <TextView
                android:id="@+id/tvLabelApellidos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:text="@string/label_last_names"
                android:textColor="@color/black"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilNombres" />

            <!-- INPUT: Apellidos -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilApellidos"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/selector_border_input"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_identification_badge"
                app:startIconTint="@color/text_gray"
                app:layout_constraintTop_toBottomOf="@id/tvLabelApellidos">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etApellidos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:hint="@string/hint_last_names"
                    android:inputType="textPersonName"
                    android:paddingVertical="16dp"
                    android:paddingStart="4dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/text_gray"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ETIQUETA: Correo Electrónico -->
            <TextView
                android:id="@+id/tvLabelEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:text="@string/label_email"
                android:textColor="@color/black"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilApellidos" />

            <!-- INPUT: Correo Electrónico -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmail"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/selector_border_input"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_envelope_simple"
                app:startIconTint="@color/text_gray"
                app:layout_constraintTop_toBottomOf="@id/tvLabelEmail">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:hint="@string/hint_email"
                    android:inputType="textEmailAddress"
                    android:paddingVertical="16dp"
                    android:paddingStart="4dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/text_gray"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ETIQUETA: Fecha de nacimiento -->
            <TextView
                android:id="@+id/tvLabelFechaNac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:text="@string/label_birth_date"
                android:textColor="@color/black"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilEmail" />

            <!-- INPUT: Fecha de nacimiento (con ícono calendario a la derecha) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFechaNac"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/selector_border_input"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:hintEnabled="false"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_calendar"
                app:endIconTint="@color/text_gray"
                app:layout_constraintTop_toBottomOf="@id/tvLabelFechaNac">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFechaNac"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:hint="@string/hint_birth_date_format"
                    android:inputType="date"
                    android:paddingVertical="16dp"
                    android:paddingStart="16dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/text_gray"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ETIQUETA: Teléfono -->
            <TextView
                android:id="@+id/tvLabelTelefono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:text="@string/label_phone"
                android:textColor="@color/black"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilFechaNac" />

            <!-- INPUT: Teléfono -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTelefono"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/selector_border_input"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_phone"
                app:startIconTint="@color/text_gray"
                app:layout_constraintTop_toBottomOf="@id/tvLabelTelefono">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:hint="@string/hint_phone"
                    android:inputType="phone"
                    android:paddingVertical="16dp"
                    android:paddingStart="4dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/text_gray"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvLabelProfesion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:text="@string/label_profession"
                android:textColor="@color/black"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilBiografia" />

            <!-- INPUT: Profesión (Menú Desplegable) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilProfesion"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/selector_border_input"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_briefcase"
                app:startIconTint="@color/text_gray"
                app:layout_constraintTop_toBottomOf="@id/tvLabelProfesion">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actvProfesion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:hint="@string/hint_select_profession"
                    android:inputType="none"
                    android:paddingVertical="16dp"
                    android:paddingStart="4dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/text_gray"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ETIQUETA: País -->
            <TextView
                android:id="@+id/tvLabelPais"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:text="@string/label_country"
                android:textColor="@color/black"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilTelefono" />

            <!-- INPUT: País -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPais"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/selector_border_input"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_globe"
                app:startIconTint="@color/text_gray"
                app:layout_constraintTop_toBottomOf="@id/tvLabelPais">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPais"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:hint="@string/hint_country"
                    android:inputType="text"
                    android:paddingVertical="16dp"
                    android:paddingStart="4dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/text_gray"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ETIQUETA: Ciudad -->
            <TextView
                android:id="@+id/tvLabelCiudad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:text="@string/label_city"
                android:textColor="@color/black"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilPais" />

            <!-- INPUT: Ciudad -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCiudad"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/selector_border_input"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_building"
                app:startIconTint="@color/text_gray"
                app:layout_constraintTop_toBottomOf="@id/tvLabelCiudad">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCiudad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:hint="@string/hint_city"
                    android:inputType="text"
                    android:paddingVertical="16dp"
                    android:paddingStart="4dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/text_gray"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ETIQUETA: Biografía -->
            <TextView
                android:id="@+id/tvLabelBiografia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:text="@string/label_bio"
                android:textColor="@color/black"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilCiudad" />

            <!-- INPUT: Biografía -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilBiografia"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/selector_border_input"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:hintEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/tvLabelBiografia">

                <!-- textMultiLine para permitir un cuadro de texto expandido -->
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBiografia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:gravity="top|start"
                    android:hint="@string/hint_bio"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/text_gray"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ETIQUETA: Contraseña -->
            <TextView
                android:id="@+id/tvLabelPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:text="@string/label_password"
                android:textColor="@color/black"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilProfesion" />

            <!-- INPUT: Contraseña (Como en login y en la imagen) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/selector_border_input"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:hintEnabled="false"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@color/text_gray"
                app:startIconDrawable="@drawable/ic_lock"
                app:startIconTint="@color/text_gray"
                app:layout_constraintTop_toBottomOf="@id/tvLabelPassword">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:hint="@string/msg_password_min_length"
                    android:inputType="textPassword"
                    android:paddingVertical="16dp"
                    android:paddingStart="4dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/text_gray"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- BOTÓN CTA: Crear cuenta -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="40dp"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:includeFontPadding="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/action_create_account"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:backgroundTint="@color/purple"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_arrow_right_white"
                app:iconGravity="textEnd"
                app:iconPadding="12dp"
                app:iconSize="20dp"
                app:iconTint="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilPassword" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>