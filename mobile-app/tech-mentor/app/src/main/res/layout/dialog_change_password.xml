<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_auth_tabs">

    <TextView
        android:id="@+id/tvTitleChangePassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/plus_jakarta_sans_extrabold"
        android:text="Actualizar Credenciales"
        android:textColor="@color/black"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvSubtitleChangePassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/plus_jakarta_sans_medium"
        android:text="Ingresa tu contraseña actual y define tu nueva clave."
        android:textColor="@color/text_dark"
        android:textSize="12sp" />

    <!-- Clave actual -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCurrentPassword"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:boxBackgroundColor="@color/white"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:passwordToggleEnabled="true"
        app:passwordToggleTint="@color/purple"
        app:startIconDrawable="@drawable/ic_lock"
        app:startIconTint="@color/text_gray"
        app:boxStrokeColor="@color/purple">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCurrentPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans_semibold"
            android:hint="Contraseña actual"
            android:inputType="textPassword"
            android:textColor="@color/black"
            android:textColorHint="@color/text_gray"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Clave nueva -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilNewPassword"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:boxBackgroundColor="@color/white"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:passwordToggleEnabled="true"
        app:passwordToggleTint="@color/purple"
        app:startIconDrawable="@drawable/ic_lock"
        app:startIconTint="@color/text_gray"
        app:boxStrokeColor="@color/purple">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNewPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans_semibold"
            android:hint="Nueva contraseña (mínimo 8 caracteres)"
            android:inputType="textPassword"
            android:textColor="@color/black"
            android:textColorHint="@color/text_gray"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Confirmar clave -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilConfirmPassword"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:boxBackgroundColor="@color/white"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:passwordToggleEnabled="true"
        app:passwordToggleTint="@color/purple"
        app:startIconDrawable="@drawable/ic_lock"
        app:startIconTint="@color/text_gray"
        app:boxStrokeColor="@color/purple">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans_semibold"
            android:hint="Confirmar nueva contraseña"
            android:inputType="textPassword"
            android:textColor="@color/black"
            android:textColorHint="@color/text_gray"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelChangePassword"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="@color/text_gray" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitChangePassword"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1.5"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:text="Actualizar"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/purple"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
