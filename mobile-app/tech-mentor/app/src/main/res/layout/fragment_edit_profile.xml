<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fitsSystemWindows="true">

    <!-- HEADER -->
    <include
        android:id="@+id/header"
        layout="@layout/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- SCROLLVIEW -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="20dp">

            <!-- BOTÓN ATRÁS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/selector_border_input"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_left"
                    app:tint="@color/black"
                    tools:src="@drawable/ic_arrow_left" />
            </com.google.android.material.card.MaterialCardView>

            <!-- TÍTULO SUPERIOR -->
            <TextView
                android:id="@+id/tvEditProfileHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/title_edit_profile"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/cvBack"
                app:layout_constraintStart_toEndOf="@id/cvBack"
                app:layout_constraintTop_toTopOf="@id/cvBack" />

            <!-- SECCIÓN: CAMBIAR AVATAR -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvAvatar"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="@color/bg_purple"
                app:cardCornerRadius="48dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/purple"
                app:strokeWidth="1.5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cvBack">

                <ImageView
                    android:id="@+id/ivAvatarPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:src="@tools:sample/avatars" />

                <!-- Overlay sutil con ícono de cámara -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#33000000">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/white" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvCambiarFoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:text="@string/action_change_profile_photo"
                android:textColor="@color/purple"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cvAvatar" />

            <!-- ETIQUETA: Nombres -->
            <TextView
                android:id="@+id/tvLabelNombres"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:text="@string/label_first_names"
                android:textColor="@color/black"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCambiarFoto" />

            <!-- INPUT: Nombres -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNombres"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/selector_border_input"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_user"
                app:startIconTint="@color/text_gray"
                app:layout_constraintTop_toBottomOf="@id/tvLabelNombres">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombres"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:hint="@string/hint_first_names"
                    android:inputType="textPersonName"
                    android:paddingVertical="16dp"
                    android:paddingStart="4dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/text_gray"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ETIQUETA: Apellidos -->
            <TextView
                android:id="@+id/tvLabelApellidos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:text="@string/label_last_names"
                android:textColor="@color/black"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilNombres" />

            <!-- INPUT: Apellidos -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilApellidos"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/selector_border_input"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_identification_badge"
                app:startIconTint="@color/text_gray"
                app:layout_constraintTop_toBottomOf="@id/tvLabelApellidos">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etApellidos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:hint="@string/hint_last_names"
                    android:inputType="textPersonName"
                    android:paddingVertical="16dp"
                    android:paddingStart="4dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/text_gray"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ETIQUETA: Fecha de nacimiento -->
            <TextView
                android:id="@+id/tvLabelFechaNac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:text="@string/label_birth_date"
                android:textColor="@color/black"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilApellidos" />

            <!-- INPUT: Fecha de nacimiento -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFechaNac"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/selector_border_input"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:endIconDrawable="@drawable/ic_calendar"
                app:endIconMode="custom"
                app:endIconTint="@color/text_gray"
                app:hintEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/tvLabelFechaNac">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFechaNac"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="false"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:hint="@string/hint_birth_date_format"
                    android:inputType="date"
                    android:paddingVertical="16dp"
                    android:paddingStart="16dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/text_gray"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ETIQUETA: Teléfono -->
            <TextView
                android:id="@+id/tvLabelTelefono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:text="@string/label_phone"
                android:textColor="@color/black"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilFechaNac" />

            <!-- INPUT: Teléfono -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTelefono"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/selector_border_input"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_phone"
                app:startIconTint="@color/text_gray"
                app:layout_constraintTop_toBottomOf="@id/tvLabelTelefono">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:hint="@string/hint_phone"
                    android:inputType="phone"
                    android:paddingVertical="16dp"
                    android:paddingStart="4dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/text_gray"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ETIQUETA: País -->
            <TextView
                android:id="@+id/tvLabelPais"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:text="@string/label_country"
                android:textColor="@color/black"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilTelefono" />

            <!-- INPUT: País -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPais"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/selector_border_input"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_globe"
                app:startIconTint="@color/text_gray"
                app:layout_constraintTop_toBottomOf="@id/tvLabelPais">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPais"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:hint="@string/hint_country"
                    android:inputType="text"
                    android:paddingVertical="16dp"
                    android:paddingStart="4dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/text_gray"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ETIQUETA: Ciudad -->
            <TextView
                android:id="@+id/tvLabelCiudad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:text="@string/label_city"
                android:textColor="@color/black"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilPais" />

            <!-- INPUT: Ciudad -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCiudad"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/selector_border_input"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_building"
                app:startIconTint="@color/text_gray"
                app:layout_constraintTop_toBottomOf="@id/tvLabelCiudad">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCiudad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:hint="@string/hint_city"
                    android:inputType="text"
                    android:paddingVertical="16dp"
                    android:paddingStart="4dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/text_gray"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ETIQUETA: Profesión -->
            <TextView
                android:id="@+id/tvLabelProfesion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:text="@string/label_profession"
                android:textColor="@color/black"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilCiudad" />

            <!-- INPUT: Profesión (Menú Desplegable) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilProfesion"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/selector_border_input"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_briefcase"
                app:startIconTint="@color/text_gray"
                app:layout_constraintTop_toBottomOf="@id/tvLabelProfesion">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actvProfesion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:hint="@string/hint_select_profession"
                    android:inputType="none"
                    android:paddingVertical="16dp"
                    android:paddingStart="4dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/text_gray"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ETIQUETA: Biografía -->
            <TextView
                android:id="@+id/tvLabelBiografia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:text="@string/label_bio"
                android:textColor="@color/black"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilProfesion" />

            <!-- INPUT: Biografía -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilBiografia"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/selector_border_input"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:hintEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/tvLabelBiografia">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBiografia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:gravity="top|start"
                    android:hint="@string/hint_bio"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/text_gray"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- BOTÓN CTA: Guardar cambios -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="40dp"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:includeFontPadding="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/btn_save_changes"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:backgroundTint="@color/purple"
                app:cornerRadius="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilBiografia" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>