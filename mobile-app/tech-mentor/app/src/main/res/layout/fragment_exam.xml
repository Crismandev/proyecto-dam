<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fitsSystemWindows="true">

    <!-- HEADER -->
    <include
        android:id="@+id/header"
        layout="@layout/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- FILA DE PROGRESO -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clExamProgressRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/header">

        <!-- Botón Cerrar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvCloseExam"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/gray_light"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_x"
                app:tint="@color/black" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Barra de Progreso -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/pbExamProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:indicatorColor="@color/purple"
            app:indicatorTrackGapSize="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvExamProgressText"
            app:layout_constraintStart_toEndOf="@id/cvCloseExam"
            app:layout_constraintTop_toTopOf="parent"
            app:trackColor="@color/bg_purple"
            app:trackCornerRadius="4dp"
            app:trackStopIndicatorSize="0dp"
            app:trackThickness="8dp"
            tools:progress="33" />

        <!-- Texto de Progreso -->
        <TextView
            android:id="@+id/tvExamProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:textColor="@color/text_gray"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="1 de 3" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/btnCheckExamAnswer"
        app:layout_constraintTop_toBottomOf="@id/clExamProgressRow">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <!-- CONTEXTO Y ENUNCIADO -->
            <TextView
                android:id="@+id/tvExamContext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="32dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:letterSpacing="0.1"
                android:textAllCaps="true"
                android:textColor="@color/purple"
                android:textSize="12sp"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="DIAGNÓSTICO · FUNDAMENTOS DE APIS" />

            <TextView
                android:id="@+id/tvExamQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:textColor="@color/black"
                android:textSize="28sp"
                app:layout_constraintTop_toBottomOf="@id/tvExamContext"
                tools:text="¿Qué es una API?" />

            <TextView
                android:id="@+id/tvExamQuestionHelper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:textColor="@color/text_gray"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/tvExamQuestion"
                tools:text="Selecciona la respuesta que mejor describa el concepto." />

            <!-- RECYCLER VIEW -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvExamOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="24dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@id/tvExamQuestionHelper"
                tools:itemCount="4"
                tools:listitem="@layout/item_exercise_option" />

            <!-- FOOTER: Texto de ánimo -->
            <TextView
                android:id="@+id/tvExamEncouragement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:text="Responde con sinceridad para ubicarte en tu nivel ideal."
                android:textColor="@color/text_gray"
                android:textSize="11sp"
                app:layout_constraintTop_toBottomOf="@id/rvExamOptions" />

            <!-- CUADRO DE EXPLICACIÓN -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvExamFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/tvExamEncouragement"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:id="@+id/tvExamFeedbackTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_extrabold"
                        android:paddingBottom="2dp"
                        android:textSize="16sp"
                        tools:text="¡Respuesta correcta!" />

                    <TextView
                        android:id="@+id/tvExamFeedbackExplanation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/plus_jakarta_sans_medium"
                        android:lineSpacingExtra="4dp"
                        android:paddingBottom="4dp"
                        android:textSize="14sp"
                        tools:text="Una API define cómo un sistema puede pedir información o acciones a otro." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTÓN: COMPROBAR -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCheckExamAnswer"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:fontFamily="@font/plus_jakarta_sans_bold"
        android:text="Comprobar"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:backgroundTint="@color/purple"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>