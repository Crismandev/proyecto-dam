<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/gray_light"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- INDICADOR DE ORDEN -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvLevelIndicator"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardBackgroundColor="@color/bg_purple"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/bg_purple"
            app:strokeWidth="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvLevelOrder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:textColor="@color/purple"
                android:textSize="16sp"
                tools:text="1" />
        </com.google.android.material.card.MaterialCardView>

        <!-- NOMBRE DEL NIVEL -->
        <TextView
            android:id="@+id/tvLevelName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:textColor="@color/black"
            android:textSize="15sp"
            app:layout_constraintBottom_toTopOf="@id/tvLevelDescription"
            app:layout_constraintEnd_toStartOf="@id/ivAction"
            app:layout_constraintStart_toEndOf="@id/cvLevelIndicator"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Nivel Básico" />

        <!-- DESCRIPCIÓN -->
        <TextView
            android:id="@+id/tvLevelDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:textColor="@color/text_gray"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ivAction"
            app:layout_constraintStart_toEndOf="@id/cvLevelIndicator"
            app:layout_constraintTop_toBottomOf="@id/tvLevelName"
            tools:text="Comienza aquí tu aprendizaje" />

        <!-- ÍCONO -->
        <ImageView
            android:id="@+id/ivAction"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_up_right"
            app:tint="@color/purple"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>