<?xml version="1.0" encoding="utf-8"?>
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="6000"
    android:repeatCount="infinite"
    android:repeatMode="restart"
    android:interpolator="@android:interpolator/linear">
    <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
        <keyframe android:fraction="0" android:value="1" />
        <keyframe android:fraction="0.43" android:value="1" />
        <keyframe android:fraction="0.45" android:value="0.12" />
        <keyframe android:fraction="0.47" android:value="1" />
        <keyframe android:fraction="1" android:value="1" />
    </propertyValuesHolder>
</objectAnimator>
