<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="24dp">

        <!-- Imagen del curso -->

        <ImageView
            android:id="@+id/ivCursoDetalle"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:contentDescription="Imagen del curso" />

        <!-- Nombre -->

        <TextView
            android:id="@+id/tvCursoDetalleNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del curso"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="24dp" />

        <!-- Descripción -->

        <TextView
            android:id="@+id/tvCursoDetalleDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción del curso"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="12dp" />

        <!-- Título niveles -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Elige tu nivel de aprendizaje"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="32dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona el nivel desde el que deseas comenzar."
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp" />

        <!-- Básico -->

        <Button
            android:id="@+id/btnNivelBasico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BÁSICO"
            android:layout_marginBottom="12dp" />

        <!-- Intermedio -->

        <Button
            android:id="@+id/btnNivelIntermedio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INTERMEDIO"
            android:layout_marginBottom="12dp" />

        <!-- Avanzado -->

        <Button
            android:id="@+id/btnNivelAvanzado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AVANZADO" />

    </LinearLayout>

</ScrollView>