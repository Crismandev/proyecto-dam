<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginBottom="12dp"
    android:background="#F2F6FF">

    <!-- IMAGEN DEL CURSO -->

    <ImageView
        android:id="@+id/ivCurso"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_gravity="center_vertical"
        android:scaleType="centerCrop"
        android:contentDescription="Imagen del curso" />

    <!-- INFORMACIÓN DEL CURSO -->

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp">

        <TextView
            android:id="@+id/tvNombreCurso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="APIs con Spring Boot"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDescripcionCurso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aprende a crear APIs REST utilizando Spring Boot."
            android:textSize="13sp"
            android:layout_marginTop="5dp" />

        <Button
            android:id="@+id/btnVerCurso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ver curso"
            android:textSize="13sp"
            android:layout_marginTop="6dp" />

    </LinearLayout>

</LinearLayout>