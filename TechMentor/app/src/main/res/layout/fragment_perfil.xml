<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mi Perfil"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- FOTO -->

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivFotoPerfil"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:src="@drawable/ic_launcher_foreground"
            android:scaleType="centerCrop" />

        <!-- NOMBRE -->

        <TextView
            android:id="@+id/tvNombrePerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Luis Pinedo"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvProfesionPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profesión"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginTop="4dp" />

        <!-- INFORMACIÓN -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Información personal"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvCorreoPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📧 Correo"
            android:textSize="15sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvFechaNacimientoPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎂 Fecha de nacimiento"
            android:textSize="15sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvTelefonoPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📱 Teléfono"
            android:textSize="15sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvUbicacionPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌎 País - Ciudad"
            android:textSize="15sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvBiografiaPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📝 Biografía"
            android:textSize="15sp"
            android:padding="8dp" />

        <!-- BOTONES -->

        <Button
            android:id="@+id/btnEditarPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EDITAR PERFIL"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btnCambiarPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CAMBIAR CONTRASEÑA"
            android:layout_marginTop="10dp" />

    </LinearLayout>

</ScrollView>